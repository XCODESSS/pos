# Prefer: node ops/configure-staging.mjs BACKEND_IMAGE WEB_IMAGE
# This example is not runnable until all placeholders are replaced.
BACKEND_IMAGE=counterline-backend:verified-commit
WEB_IMAGE=counterline-web:verified-commit
DB_ADMIN_PASSWORD=replace-with-a-separate-admin-secret
STAGING_DB_PASSWORD=replace-with-a-separate-tenant-secret
# Use a new canonical UUID and business code, retaining them for this database's lifetime.
# The registry password must match STAGING_DB_PASSWORD; generate both together with the script.
TENANTS_JSON=[{"id":"22222222-2222-4222-8222-222222222222","slug":"stage-demo","jdbcUrl":"jdbc:postgresql://db:5432/tenant_stage","username":"tenant_stage","password":"replace-with-a-separate-tenant-secret","ownerUsername":"stage-owner","ownerPassword":"replace-with-a-unique-generated-owner-password"}]
