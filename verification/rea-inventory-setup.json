{
  "browser":{"mode":"launch","executable_path":"{{CHROME}}","headless":true},
  "start_url":{"url":"{{ORIGIN}}/t/alpha/"},
  "environment":{"locale":"en-IN","timezone":"Asia/Kolkata","viewport":{"width":1440,"height":1050,"device_scale_factor":1}},
  "secrets":[{"secret_id":"owner","environment_variable":"VERIFY_OWNER_PASSWORD"}],
  "actions":[
    {"step_id":"username","action":"fill","locator":{"kind":"css","selector":"#username"},"value":{"source":"literal","value":"verify-owner"}},
    {"step_id":"password","action":"fill","locator":{"kind":"css","selector":"#password"},"value":{"source":"secret","secret_id":"owner"}},
    {"step_id":"signin","action":"click","locator":{"kind":"role","role":"button","name":"Sign in →"}},
    {"step_id":"inventory","action":"click","locator":{"kind":"role","role":"button","name":"Inventory & recipes"}},
    {"step_id":"ingredient-name","action":"fill","locator":{"kind":"css","selector":"#ingredient-name"},"value":{"source":"literal","value":"Browser paneer"}},
    {"step_id":"threshold","action":"fill","locator":{"kind":"css","selector":"#ingredient-threshold"},"value":{"source":"literal","value":"20"}},
    {"step_id":"create-ingredient","action":"click","locator":{"kind":"role","role":"button","name":"Create ingredient"}},
    {"step_id":"receipt-quantity","action":"fill","locator":{"kind":"css","selector":"#stock-quantity"},"value":{"source":"literal","value":"100"}},
    {"step_id":"receipt-reason","action":"fill","locator":{"kind":"css","selector":"#stock-reason"},"value":{"source":"literal","value":"Browser delivery"}},
    {"step_id":"receive","action":"click","locator":{"kind":"role","role":"button","name":"Record stock movement"}},
    {"step_id":"received","action":"wait_for","locator":{"kind":"css","selector":".stock-balance:has-text('100 g')"},"state":"visible","timeout_ms":20000},
    {"step_id":"waste-kind","action":"select_option","locator":{"kind":"css","selector":"#stock-kind"},"value":{"source":"literal","value":"WASTE"}},
    {"step_id":"waste-quantity","action":"fill","locator":{"kind":"css","selector":"#stock-quantity"},"value":{"source":"literal","value":"5"}},
    {"step_id":"waste-reason","action":"fill","locator":{"kind":"css","selector":"#stock-reason"},"value":{"source":"literal","value":"Browser spillage"}},
    {"step_id":"waste","action":"click","locator":{"kind":"role","role":"button","name":"Record stock movement"}},
    {"step_id":"wasted","action":"wait_for","locator":{"kind":"css","selector":".stock-balance:has-text('95 g')"},"state":"visible","timeout_ms":20000},
    {"step_id":"adjust-kind","action":"select_option","locator":{"kind":"css","selector":"#stock-kind"},"value":{"source":"literal","value":"ADJUSTMENT"}},
    {"step_id":"adjust-quantity","action":"fill","locator":{"kind":"css","selector":"#stock-quantity"},"value":{"source":"literal","value":"5"}},
    {"step_id":"adjust-reason","action":"fill","locator":{"kind":"css","selector":"#stock-reason"},"value":{"source":"literal","value":"Browser count correction"}},
    {"step_id":"adjust","action":"click","locator":{"kind":"role","role":"button","name":"Record stock movement"}},
    {"step_id":"adjusted","action":"wait_for","locator":{"kind":"css","selector":".stock-balance:has-text('100 g')"},"state":"visible","timeout_ms":20000},
    {"step_id":"menu","action":"click","locator":{"kind":"role","role":"button","name":"Menu management"}},
    {"step_id":"dish-name","action":"fill","locator":{"kind":"css","selector":"#dish-name"},"value":{"source":"literal","value":"Inventory thali"}},
    {"step_id":"dish-category","action":"fill","locator":{"kind":"css","selector":"#dish-category"},"value":{"source":"literal","value":"Inventory browser"}},
    {"step_id":"dish-price","action":"fill","locator":{"kind":"css","selector":"#dish-price"},"value":{"source":"literal","value":"120"}},
    {"step_id":"dish-create","action":"click","locator":{"kind":"role","role":"button","name":"Create dish"}},
    {"step_id":"dish-saved","action":"wait_for","locator":{"kind":"role","role":"button","name":"Edit dish Inventory thali"},"state":"visible","timeout_ms":20000},
    {"step_id":"inventory-return","action":"click","locator":{"kind":"role","role":"button","name":"Inventory & recipes"}},
    {"step_id":"stock-visible","action":"click","locator":{"kind":"css","selector":".stock-balance"}}
  ],
  "capture":{"after_each_step":["accessibility"],"at_end":["accessibility","screenshot","url"],"events":["page-errors"]}
}
