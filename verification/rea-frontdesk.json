{
  "browser": {"mode":"launch","executable_path":"{{CHROME}}","headless":true},
  "start_url": {"url":"{{ORIGIN}}/t/alpha/"},
  "environment": {"locale":"en-IN","timezone":"Asia/Kolkata","viewport":{"width":1440,"height":1050,"device_scale_factor":1}},
  "secrets": [{"secret_id":"owner","environment_variable":"VERIFY_OWNER_PASSWORD"}],
  "actions": [
    {"step_id":"username","action":"fill","locator":{"kind":"css","selector":"#username"},"value":{"source":"literal","value":"verify-owner"}},
    {"step_id":"password","action":"fill","locator":{"kind":"css","selector":"#password"},"value":{"source":"secret","secret_id":"owner"}},
    {"step_id":"signin","action":"click","locator":{"kind":"role","role":"button","name":"Sign in →"}},
    {"step_id":"catalog","action":"click","locator":{"kind":"role","role":"button","name":"Menu management"}},
    {"step_id":"dish-name","action":"fill","locator":{"kind":"css","selector":"#dish-name"},"value":{"source":"literal","value":"Browser thali"}},
    {"step_id":"dish-category","action":"fill","locator":{"kind":"css","selector":"#dish-category"},"value":{"source":"literal","value":"Browser"}},
    {"step_id":"dish-base-price","action":"fill","locator":{"kind":"css","selector":"#dish-price"},"value":{"source":"literal","value":"100.00"}},
    {"step_id":"add-variant","action":"click","locator":{"kind":"role","role":"button","name":"Add variant"}},
    {"step_id":"variant-name","action":"fill","locator":{"kind":"css","selector":"[aria-label='Variants name 1']"},"value":{"source":"literal","value":"Large"}},
    {"step_id":"variant-price","action":"fill","locator":{"kind":"css","selector":"[aria-label='Variants price 1']"},"value":{"source":"literal","value":"150.00"}},
    {"step_id":"add-addon","action":"click","locator":{"kind":"role","role":"button","name":"Add add-on"}},
    {"step_id":"addon-name","action":"fill","locator":{"kind":"css","selector":"[aria-label='Add-ons name 1']"},"value":{"source":"literal","value":"Cheese"}},
    {"step_id":"addon-price","action":"fill","locator":{"kind":"css","selector":"[aria-label='Add-ons price 1']"},"value":{"source":"literal","value":"20.00"}},
    {"step_id":"save-dish","action":"click","locator":{"kind":"role","role":"button","name":"Create dish"}},
    {"step_id":"dish-saved","action":"wait_for","locator":{"kind":"role","role":"button","name":"Edit dish Browser thali"},"state":"visible","timeout_ms":20000},
    {"step_id":"tables","action":"click","locator":{"kind":"role","role":"button","name":"Tables & checks"}},
    {"step_id":"open-table","action":"click","locator":{"kind":"css","selector":".table-card:has-text('Browser A')"}},
    {"step_id":"choose-dish","action":"click","locator":{"kind":"role","role":"button","name":"Add Browser thali"}},
    {"step_id":"choose-variant","action":"check","locator":{"kind":"css","selector":"dialog input[type='radio']"}},
    {"step_id":"choose-addon","action":"check","locator":{"kind":"css","selector":"dialog input[type='checkbox']"}},
    {"step_id":"add-configured","action":"click","locator":{"kind":"css","selector":"dialog button:has-text('Add to order')"}},
    {"step_id":"two-servings","action":"click","locator":{"kind":"css","selector":".check-composer .stepper button:has-text('+')"}},
    {"step_id":"first-batch","action":"click","locator":{"kind":"role","role":"button","name":"Send batch to kitchen"}},
    {"step_id":"first-saved","action":"wait_for","locator":{"kind":"css","selector":".batch-card:has-text('Kitchen batch 1')"},"state":"visible","timeout_ms":20000},
    {"step_id":"add-coffee","action":"click","locator":{"kind":"role","role":"button","name":"Add Browser coffee"}},
    {"step_id":"second-batch","action":"click","locator":{"kind":"role","role":"button","name":"Send batch to kitchen"}},
    {"step_id":"second-saved","action":"wait_for","locator":{"kind":"css","selector":".batch-card:has-text('Kitchen batch 2')"},"state":"visible","timeout_ms":20000},
    {"step_id":"kitchen","action":"click","locator":{"kind":"role","role":"button","name":"Kitchen display"}},
    {"step_id":"prepare","action":"click","locator":{"kind":"css","selector":".lane-queued .kitchen-card:has-text('Browser thali') button"}},
    {"step_id":"mark-ready","action":"click","locator":{"kind":"css","selector":".lane-preparing .kitchen-card:has-text('Browser thali') button"}},
    {"step_id":"ready-visible","action":"wait_for","locator":{"kind":"css","selector":".lane-ready .kitchen-card:has-text('Browser thali')"},"state":"visible","timeout_ms":20000},
    {"step_id":"return-to-check","action":"click","locator":{"kind":"role","role":"button","name":"Tables & checks"}},
    {"step_id":"destination","action":"select_option","locator":{"kind":"css","selector":"[aria-label='Transfer to table']"},"value":{"source":"literal","value":"{{DESTINATION_ID}}"}},
    {"step_id":"transfer","action":"click","locator":{"kind":"role","role":"button","name":"Transfer check"}},
    {"step_id":"transferred","action":"wait_for","locator":{"kind":"css","selector":".running-check h2:has-text('Browser B')"},"state":"visible","timeout_ms":20000},
    {"step_id":"split-amount","action":"fill","locator":{"kind":"css","selector":"[aria-label='Cash split amount (INR)']"},"value":{"source":"literal","value":"200.00"}},
    {"step_id":"request-split","action":"click","locator":{"kind":"role","role":"button","name":"Record cash split"}},
    {"step_id":"cancel-cash","action":"click","locator":{"kind":"role","role":"button","name":"Cancel cash confirmation"}},
    {"step_id":"request-again","action":"click","locator":{"kind":"role","role":"button","name":"Record cash split"}},
    {"step_id":"confirm-first","action":"click","locator":{"kind":"role","role":"button","name":"Confirm cash received"}},
    {"step_id":"partial-visible","action":"wait_for","locator":{"kind":"css","selector":".running-check:has-text('SETTLING')"},"state":"visible","timeout_ms":20000},
    {"step_id":"remaining","action":"click","locator":{"kind":"css","selector":"button:has-text('Record remaining')"}},
    {"step_id":"confirm-final","action":"click","locator":{"kind":"role","role":"button","name":"Confirm cash received"}},
    {"step_id":"closed","action":"wait_for","locator":{"kind":"css","selector":".running-check .paid-message"},"state":"visible","timeout_ms":20000},
    {"step_id":"receipt-summary","action":"click","locator":{"kind":"css","selector":".running-check h2"}}
  ],
  "capture": {"after_each_step":["accessibility"],"at_end":["screenshot","accessibility","url","storage"],"events":["page-errors"]}
}
