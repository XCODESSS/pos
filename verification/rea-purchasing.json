{
  "browser":{"mode":"launch","executable_path":"{{CHROME}}","headless":true},
  "start_url":{"url":"{{ORIGIN}}/t/alpha/"},
  "environment":{"locale":"en-IN","timezone":"Asia/Kolkata","viewport":{"width":1440,"height":1050,"device_scale_factor":1}},
  "secrets":[{"secret_id":"owner","environment_variable":"VERIFY_BROWSER_OWNER_PASSWORD"}],
  "actions":[
    {"step_id":"username","action":"fill","locator":{"kind":"css","selector":"#username"},"value":{"source":"literal","value":"{{BROWSER_OWNER}}"}},
    {"step_id":"password","action":"fill","locator":{"kind":"css","selector":"#password"},"value":{"source":"secret","secret_id":"owner"}},
    {"step_id":"signin","action":"click","locator":{"kind":"role","role":"button","name":"Sign in →"}},
    {"step_id":"purchasing","action":"click","locator":{"kind":"role","role":"button","name":"Supplier purchasing"}},
    {"step_id":"supplier-editor","action":"click","locator":{"kind":"css","selector":".supplier-create summary"}},
    {"step_id":"supplier-name","action":"fill","locator":{"kind":"css","selector":"#supplier-name"},"value":{"source":"literal","value":"Browser dairy supplier"}},
    {"step_id":"supplier-contact","action":"fill","locator":{"kind":"css","selector":"#supplier-contact"},"value":{"source":"literal","value":"Delivery desk"}},
    {"step_id":"review-supplier","action":"click","locator":{"kind":"role","role":"button","name":"Review supplier"}},
    {"step_id":"confirm-supplier","action":"click","locator":{"kind":"role","role":"button","name":"Confirm purchase action"}},
    {"step_id":"purchase-reference","action":"fill","locator":{"kind":"css","selector":"#purchase-reference"},"value":{"source":"literal","value":"Browser replenishment"}},
    {"step_id":"purchase-ingredient","action":"select_option","locator":{"kind":"css","selector":"#purchase-ingredient"},"value":{"source":"literal","value":"{{INGREDIENT_ID}}"}},
    {"step_id":"purchase-line","action":"click","locator":{"kind":"role","role":"button","name":"Add purchase ingredient"}},
    {"step_id":"ordered-quantity","action":"fill","locator":{"kind":"css","selector":"[aria-label='Ordered quantity 1']"},"value":{"source":"literal","value":"100"}},
    {"step_id":"review-order","action":"click","locator":{"kind":"role","role":"button","name":"Review purchase order"}},
    {"step_id":"order-no-stock","action":"wait_for","locator":{"kind":"css","selector":".purchase-review:has-text('Stock will not change')"},"state":"visible","timeout_ms":20000},
    {"step_id":"confirm-order","action":"click","locator":{"kind":"role","role":"button","name":"Confirm purchase action"}},
    {"step_id":"open-order","action":"wait_for","locator":{"kind":"css","selector":".purchase-detail .purchase-status:has-text('OPEN'):has-text('Browser replenishment')"},"state":"visible","timeout_ms":20000},
    {"step_id":"first-quantity","action":"fill","locator":{"kind":"css","selector":"[aria-label='Delivered Browser paneer']"},"value":{"source":"literal","value":"40"}},
    {"step_id":"first-reference","action":"fill","locator":{"kind":"css","selector":"#delivery-reference"},"value":{"source":"literal","value":"Browser delivery A"}},
    {"step_id":"review-first","action":"click","locator":{"kind":"role","role":"button","name":"Review delivery"}},
    {"step_id":"confirm-first","action":"click","locator":{"kind":"role","role":"button","name":"Confirm purchase action"}},
    {"step_id":"partial-visible","action":"wait_for","locator":{"kind":"css","selector":".purchase-detail:has-text('Received 40 g'):has-text('Remaining 60 g')"},"state":"visible","timeout_ms":20000},
    {"step_id":"second-quantity","action":"fill","locator":{"kind":"css","selector":"[aria-label='Delivered Browser paneer']"},"value":{"source":"literal","value":"20"}},
    {"step_id":"second-reference","action":"fill","locator":{"kind":"css","selector":"#delivery-reference"},"value":{"source":"literal","value":"Browser delivery B"}},
    {"step_id":"review-second","action":"click","locator":{"kind":"role","role":"button","name":"Review delivery"}},
    {"step_id":"confirm-second","action":"click","locator":{"kind":"role","role":"button","name":"Confirm purchase action"}},
    {"step_id":"received-visible","action":"wait_for","locator":{"kind":"css","selector":".purchase-detail:has-text('Received 60 g'):has-text('Remaining 40 g')"},"state":"visible","timeout_ms":20000},
    {"step_id":"close-reason","action":"fill","locator":{"kind":"css","selector":"#purchase-close-reason"},"value":{"source":"literal","value":"Supplier cannot deliver remaining 40 grams"}},
    {"step_id":"review-close","action":"click","locator":{"kind":"role","role":"button","name":"Review closing remainder"}},
    {"step_id":"close-policy","action":"wait_for","locator":{"kind":"css","selector":".purchase-review:has-text('Received stock remains unchanged')"},"state":"visible","timeout_ms":20000},
    {"step_id":"confirm-close","action":"click","locator":{"kind":"role","role":"button","name":"Confirm purchase action"}},
    {"step_id":"closed-visible","action":"wait_for","locator":{"kind":"css","selector":".purchase-detail .purchase-status:has-text('CLOSED')"},"state":"visible","timeout_ms":20000},
    {"step_id":"receipt-evidence","action":"wait_for","locator":{"kind":"css","selector":".delivery-history:has-text('Browser delivery A'):has-text('Browser delivery B')"},"state":"visible","timeout_ms":20000},
    {"step_id":"summary","action":"click","locator":{"kind":"css","selector":".purchase-detail h3"}}
  ],
  "capture":{"after_each_step":["accessibility"],"at_end":["accessibility","screenshot","url"],"events":["page-errors"]}
}
