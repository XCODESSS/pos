{
  "browser":{"mode":"launch","executable_path":"{{CHROME}}","headless":true},
  "start_url":{"url":"{{ORIGIN}}/t/alpha/"},
  "environment":{"locale":"en-IN","timezone":"Asia/Kolkata","viewport":{"width":1440,"height":1050,"device_scale_factor":1}},
  "secrets":[{"secret_id":"owner","environment_variable":"VERIFY_BROWSER_OWNER_PASSWORD"}],
  "actions":[
    {"step_id":"username","action":"fill","locator":{"kind":"css","selector":"#username"},"value":{"source":"literal","value":"{{BROWSER_OWNER}}"}},
    {"step_id":"password","action":"fill","locator":{"kind":"css","selector":"#password"},"value":{"source":"secret","secret_id":"owner"}},
    {"step_id":"signin","action":"click","locator":{"kind":"role","role":"button","name":"Sign in →"}},
    {"step_id":"cash-control","action":"click","locator":{"kind":"role","role":"button","name":"Cash drawer & expenses"}},
    {"step_id":"opening","action":"fill","locator":{"kind":"css","selector":"#cash-opening"},"value":{"source":"literal","value":"1000"}},
    {"step_id":"opening-reference","action":"fill","locator":{"kind":"css","selector":"#cash-opening-reference"},"value":{"source":"literal","value":"Browser shared drawer"}},
    {"step_id":"review-open","action":"click","locator":{"kind":"role","role":"button","name":"Review opening drawer"}},
    {"step_id":"confirm-open","action":"click","locator":{"kind":"role","role":"button","name":"Confirm cash-control action"}},
    {"step_id":"open-count","action":"wait_for","locator":{"kind":"css","selector":".purchase-detail:has-text('Expected ₹1,000.00')"},"state":"visible"},
    {"step_id":"payee","action":"fill","locator":{"kind":"css","selector":"#expense-payee"},"value":{"source":"literal","value":"Browser cleaner"}},
    {"step_id":"category","action":"fill","locator":{"kind":"css","selector":"#expense-category"},"value":{"source":"literal","value":"Cleaning"}},
    {"step_id":"expense-reference","action":"fill","locator":{"kind":"css","selector":"#expense-reference"},"value":{"source":"literal","value":"Browser cleaning receipt"}},
    {"step_id":"expense-amount","action":"fill","locator":{"kind":"css","selector":"#expense-amount"},"value":{"source":"literal","value":"250"}},
    {"step_id":"review-expense","action":"click","locator":{"kind":"role","role":"button","name":"Review operating expense"}},
    {"step_id":"confirm-expense","action":"click","locator":{"kind":"role","role":"button","name":"Confirm cash-control action"}},
    {"step_id":"expense-balance","action":"wait_for","locator":{"kind":"css","selector":".purchase-detail:has-text('Expected ₹750.00')"},"state":"visible"},
    {"step_id":"payables","action":"click","locator":{"kind":"role","role":"button","name":"Supplier bills & payments"}},
    {"step_id":"supplier-bill","action":"fill","locator":{"kind":"css","selector":"#recover-supplier-bill"},"value":{"source":"literal","value":"{{CASH_SUPPLIER_BILL}}"}},
    {"step_id":"open-bill","action":"click","locator":{"kind":"css","selector":"form:has(#recover-supplier-bill) button"}},
    {"step_id":"supplier-amount","action":"fill","locator":{"kind":"css","selector":"#supplier-payment-amount"},"value":{"source":"literal","value":"100"}},
    {"step_id":"supplier-method","action":"select_option","locator":{"kind":"css","selector":"#supplier-payment-method"},"value":{"source":"literal","value":"CASH"}},
    {"step_id":"supplier-reference","action":"fill","locator":{"kind":"css","selector":"#supplier-payment-reference"},"value":{"source":"literal","value":"Browser supplier cash receipt"}},
    {"step_id":"review-supplier","action":"click","locator":{"kind":"role","role":"button","name":"Review supplier payment"}},
    {"step_id":"confirm-supplier","action":"click","locator":{"kind":"role","role":"button","name":"Confirm supplier action"}},
    {"step_id":"supplier-saved","action":"wait_for","locator":{"kind":"css","selector":".purchase-detail:has-text('Paid ₹100.00')"},"state":"visible"},
    {"step_id":"back-to-drawer","action":"click","locator":{"kind":"role","role":"button","name":"Cash drawer & expenses"}},
    {"step_id":"net-balance","action":"wait_for","locator":{"kind":"css","selector":".purchase-detail:has-text('Expected ₹650.00'):has-text('Supplier cash −₹100.00')"},"state":"visible"},
    {"step_id":"count","action":"fill","locator":{"kind":"css","selector":"#cash-counted"},"value":{"source":"literal","value":"649"}},
    {"step_id":"reason","action":"fill","locator":{"kind":"css","selector":"#cash-close-reason"},"value":{"source":"literal","value":"One rupee short on physical count"}},
    {"step_id":"review-close","action":"click","locator":{"kind":"role","role":"button","name":"Review closing drawer"}},
    {"step_id":"confirm-close","action":"click","locator":{"kind":"role","role":"button","name":"Confirm cash-control action"}},
    {"step_id":"closed","action":"wait_for","locator":{"kind":"css","selector":".purchase-detail .purchase-status:has-text('CLOSED')"},"state":"visible"},
    {"step_id":"difference","action":"wait_for","locator":{"kind":"css","selector":".purchase-detail:has-text('Counted ₹649.00'):has-text('discrepancy −₹1.00')"},"state":"visible"},
    {"step_id":"summary","action":"click","locator":{"kind":"css","selector":".purchase-detail > h3"}}
  ],
  "capture":{"after_each_step":["accessibility"],"at_end":["accessibility","screenshot","url","storage"],"events":["page-errors"]}
}
