{
  "browser":{"mode":"launch","executable_path":"{{CHROME}}","headless":true},
  "start_url":{"url":"{{ORIGIN}}/t/alpha/"},
  "environment":{"locale":"en-IN","timezone":"Asia/Kolkata","viewport":{"width":1440,"height":1050,"device_scale_factor":1}},
  "secrets":[{"secret_id":"owner","environment_variable":"VERIFY_BROWSER_OWNER_PASSWORD"},{"secret_id":"cashier","environment_variable":"VERIFY_INVENTORY_CASHIER_PASSWORD"}],
  "actions":[
    {"step_id":"username","action":"fill","locator":{"kind":"css","selector":"#username"},"value":{"source":"literal","value":"{{BROWSER_OWNER}}"}},
    {"step_id":"password","action":"fill","locator":{"kind":"css","selector":"#password"},"value":{"source":"secret","secret_id":"owner"}},
    {"step_id":"signin","action":"click","locator":{"kind":"role","role":"button","name":"Sign in →"}},
    {"step_id":"inventory","action":"click","locator":{"kind":"role","role":"button","name":"Inventory & recipes"}},
    {"step_id":"recipe-dish","action":"select_option","locator":{"kind":"css","selector":"#recipe-dish"},"value":{"source":"literal","value":"{{INVENTORY_DISH}}"}},
    {"step_id":"add-component","action":"click","locator":{"kind":"role","role":"button","name":"Add recipe ingredient"}},
    {"step_id":"component","action":"select_option","locator":{"kind":"css","selector":"[aria-label='Recipe ingredient 1']"},"value":{"source":"literal","value":"{{INGREDIENT_ID}}"}},
    {"step_id":"recipe-quantity","action":"fill","locator":{"kind":"css","selector":"[aria-label='Recipe quantity 1']"},"value":{"source":"literal","value":"70"}},
    {"step_id":"recipe-save","action":"click","locator":{"kind":"role","role":"button","name":"Save recipe version"}},
    {"step_id":"recipe-saved","action":"wait_for","locator":{"kind":"css","selector":".recipe-editor .success-note:has-text('version 1')"},"state":"visible","timeout_ms":20000},
    {"step_id":"recipe-revise","action":"fill","locator":{"kind":"css","selector":"[aria-label='Recipe quantity 1']"},"value":{"source":"literal","value":"75"}},
    {"step_id":"revision-save","action":"click","locator":{"kind":"role","role":"button","name":"Save recipe version"}},
    {"step_id":"revision-saved","action":"wait_for","locator":{"kind":"css","selector":".recipe-editor .success-note:has-text('version 2')"},"state":"visible","timeout_ms":20000},
    {"step_id":"old-version","action":"fill","locator":{"kind":"css","selector":"[aria-label='Historical recipe version']"},"value":{"source":"literal","value":"1"}},
    {"step_id":"view-old","action":"click","locator":{"kind":"role","role":"button","name":"View recipe version"}},
    {"step_id":"old-visible","action":"wait_for","locator":{"kind":"css","selector":".recipe-version:has-text('Historical')"},"state":"visible","timeout_ms":20000},
    {"step_id":"current-version","action":"click","locator":{"kind":"role","role":"button","name":"Reload current recipe"}},
    {"step_id":"current-visible","action":"wait_for","locator":{"kind":"css","selector":".recipe-version:has-text('Recipe version 2')"},"state":"visible","timeout_ms":20000},
    {"step_id":"owner-signout","action":"click","locator":{"kind":"role","role":"button","name":"Sign out"}},
    {"step_id":"cashier-name","action":"fill","locator":{"kind":"css","selector":"#username"},"value":{"source":"literal","value":"inventory-browser-cashier"}},
    {"step_id":"cashier-password","action":"fill","locator":{"kind":"css","selector":"#password"},"value":{"source":"secret","secret_id":"cashier"}},
    {"step_id":"cashier-signin","action":"click","locator":{"kind":"role","role":"button","name":"Sign in →"}},
    {"step_id":"add-dish","action":"click","locator":{"kind":"role","role":"button","name":"Add Inventory thali"}},
    {"step_id":"two-servings","action":"click","locator":{"kind":"css","selector":".ticket .stepper button:has-text('+')"}},
    {"step_id":"shortage-preview","action":"wait_for","locator":{"kind":"css","selector":"[aria-label='Stock preview result']:has-text('shortage 50 g')"},"state":"visible","timeout_ms":20000},
    {"step_id":"accept-despite-warning","action":"click","locator":{"kind":"css","selector":".ticket button:has-text('Create bill')"}},
    {"step_id":"shortage-recorded","action":"wait_for","locator":{"kind":"css","selector":".ticket [aria-label='Stock at submission']:has-text('shortage 50 g')"},"state":"visible","timeout_ms":20000},
    {"step_id":"settle","action":"click","locator":{"kind":"css","selector":".ticket button:has-text('Record exact cash')"}},
    {"step_id":"settled","action":"wait_for","locator":{"kind":"css","selector":".ticket .paid-message"},"state":"visible","timeout_ms":20000},
    {"step_id":"cashier-signout","action":"click","locator":{"kind":"role","role":"button","name":"Sign out"}},
    {"step_id":"owner-name","action":"fill","locator":{"kind":"css","selector":"#username"},"value":{"source":"literal","value":"{{BROWSER_OWNER}}"}},
    {"step_id":"owner-password","action":"fill","locator":{"kind":"css","selector":"#password"},"value":{"source":"secret","secret_id":"owner"}},
    {"step_id":"owner-signin","action":"click","locator":{"kind":"role","role":"button","name":"Sign in →"}},
    {"step_id":"ledger","action":"click","locator":{"kind":"role","role":"button","name":"Inventory & recipes"}},
    {"step_id":"manage-paneer","action":"click","locator":{"kind":"role","role":"button","name":"Manage ingredient Browser paneer"}},
    {"step_id":"negative-visible","action":"wait_for","locator":{"kind":"css","selector":".stock-negative-label:has-text('-50 g')"},"state":"visible","timeout_ms":20000},
    {"step_id":"consumption-visible","action":"wait_for","locator":{"kind":"css","selector":".stock-history article:has-text('CONSUMPTION'):has-text('-150 g')"},"state":"visible","timeout_ms":20000},
    {"step_id":"negative-summary","action":"click","locator":{"kind":"css","selector":".stock-negative-label"}}
  ],
  "capture":{"after_each_step":["accessibility"],"at_end":["accessibility","screenshot","url"],"events":["page-errors"]}
}
